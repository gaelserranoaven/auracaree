<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;" />
<title>AuraCare v3.4 · Registro de cuidado para centros de protección & Notaría Médica</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --tinta:#0E3A5D; --tinta-2:#16507C;
    --fondo:#F4F8FA; --panel:#FFFFFF;
    --vital:#0FA47A; --vital-suave:#E2F5EE;
    --alerta:#D8492B; --alerta-suave:#FCEAE5;
    --vigilancia:#DB9A2E; --vigilancia-suave:#FBF1DE;
    --texto:#1E2F38; --texto-2:#56707D; --linea:#DCE7EC;
    --radio:16px;
    --sombra:0 2px 4px rgba(14,58,93,.04),0 12px 32px -12px rgba(14,58,93,.12);
    --cifrado:#6366F1; --cifrado-suave:#EEF2FF;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'IBM Plex Sans',system-ui,sans-serif;background:var(--fondo);color:var(--texto);font-size:15px;line-height:1.5}
  h1,h2,h3,h4{font-family:'Sora',sans-serif;letter-spacing:-.01em}
  .mono{font-family:'IBM Plex Mono',monospace}
  button{font-family:inherit;cursor:pointer;border:none}
  input,select,textarea{font-family:inherit;font-size:15px;color:var(--texto)}
  :focus-visible{outline:3px solid rgba(15,164,122,.45);outline-offset:2px;border-radius:6px}
  @media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important}}

  /* LOGIN & REGISTRO */
  .login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;background:
    radial-gradient(900px 500px at 85% -10%, rgba(15,164,122,.14), transparent 60%),
    radial-gradient(700px 420px at -10% 110%, rgba(14,58,93,.10), transparent 55%), var(--fondo);padding:24px}
  .login-card{background:var(--panel);border:1px solid var(--linea);border-radius:22px;box-shadow:var(--sombra);width:100%;max-width:480px;padding:40px 36px}
  .brand{display:flex;align-items:center;gap:10px}
  .brand-name{font-family:'Sora';font-weight:700;font-size:22px;color:var(--tinta)}
  .brand-name em{font-style:normal;color:var(--vital)}
  .login-card h1{font-size:23px;margin:20px 0 6px;color:var(--tinta)}
  .login-card p.sub{color:var(--texto-2);font-size:13.5px;margin-bottom:20px}
  
  .auth-tabs{display:flex;border-bottom:2px solid var(--linea);margin-bottom:20px}
  .auth-tabs button{flex:1;padding:10px;font-weight:600;font-size:14px;background:none;color:var(--texto-2);border-bottom:3px solid transparent;margin-bottom:-2px}
  .auth-tabs button.active{color:var(--vital);border-bottom-color:var(--vital)}

  .field{margin-bottom:14px}
  .field label{display:block;font-size:12.5px;font-weight:600;color:var(--texto-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em}
  .field input,.field select,.field textarea{width:100%;padding:11px 13px;border:1.5px solid var(--linea);border-radius:10px;background:#FBFDFE;transition:border-color .15s, box-shadow .15s}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--vital);outline:none;box-shadow:0 0 0 3px rgba(15,164,122,.15)}
  
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 18px;border-radius:11px;font-weight:600;font-size:14px;transition:transform .1s,box-shadow .15s,background .15s}
  .btn:active{transform:translateY(1px)}
  .btn:disabled{opacity:.5;cursor:not-allowed}
  .btn-primary{background:var(--vital);color:#fff;box-shadow:0 6px 16px -6px rgba(15,164,122,.55)}
  .btn-primary:hover:not(:disabled){background:#0C8E69}
  .btn-ghost{background:transparent;color:var(--tinta);border:1.5px solid var(--linea)}
  .btn-ghost:hover{border-color:var(--tinta-2);background:#F2F7FA}
  .btn-tinta{background:var(--tinta);color:#fff}
  .btn-tinta:hover{background:var(--tinta-2)}
  .btn-peligro{background:var(--alerta-suave);color:var(--alerta);border:1px solid #F2C4B6}

  /* COOKIES BANNER */
  .cookie-banner{position:fixed;bottom:20px;left:20px;right:20px;max-width:880px;margin:0 auto;background:#0E3A5D;color:#fff;padding:20px 24px;border-radius:16px;box-shadow:0 16px 40px rgba(14,58,93,.35);z-index:100;display:flex;align-items:center;gap:20px;flex-wrap:wrap;border:1px solid rgba(255,255,255,.15)}
  .cookie-txt{flex:1;min-width:280px;font-size:13.5px;line-height:1.45;color:#E0ECF4}
  .cookie-txt b{color:#fff}
  .cookie-txt a{color:var(--vital-suave);text-decoration:underline;cursor:pointer}

  /* MAIN SHELL */
  .shell{display:flex;min-height:100vh}
  .sidebar{width:265px;flex:none;background:linear-gradient(180deg,#092740 0%,#0B2F4C 60%,#061E33 100%);color:#fff;display:flex;flex-direction:column;padding:22px 16px;position:sticky;top:0;height:100vh;overflow-y:auto}
  .sidebar .brand-name{color:#fff;font-size:19px}

  /* UNIDAD OPERATIVA MODERNIZADA V3.4 (ESTÉTICA 2026) */
  .sede-box-v34{
    margin:18px 0 10px;
    background:linear-gradient(135deg, rgba(255,255,255,.12) 0%, rgba(255,255,255,.04) 100%);
    border:1px solid rgba(255,255,255,.18);
    border-radius:16px;
    padding:14px 15px;
    backdrop-filter:blur(10px);
    box-shadow:0 8px 24px -6px rgba(0,0,0,.25), inset 0 1px 1px rgba(255,255,255,.2);
    transition:border-color .2s, box-shadow .2s;
  }
  .sede-box-v34:hover{
    border-color:rgba(15,164,122,.6);
    box-shadow:0 10px 28px -4px rgba(15,164,122,.2), inset 0 1px 1px rgba(255,255,255,.3);
  }
  .sede-header-v34{
    display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;
  }
  .sede-tag-v34{
    font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#79D7BC;
    display:flex;align-items:center;gap:6px;
  }
  .sede-live-dot{
    width:7px;height:7px;border-radius:50%;background:#0FA47A;box-shadow:0 0 8px #0FA47A;
    animation:pulsoLive 2s infinite;
  }
  @keyframes pulsoLive{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.2)}}
  .sede-cupos-v34{
    font-size:11px;font-weight:600;background:rgba(255,255,255,.12);color:#E0ECF4;padding:2px 8px;border-radius:99px;border:1px solid rgba(255,255,255,.15);
  }
  .sede-select-wrapper{position:relative}
  .sede-select-v34{
    width:100%;appearance:none;
    background:#072138;
    color:#FFFFFF;
    border:1.5px solid rgba(121,215,188,.3);
    border-radius:11px;
    padding:9.5px 32px 9.5px 12px;
    font-weight:600;font-size:13px;font-family:'Sora',sans-serif;
    cursor:pointer;
    transition:all .2s ease;
  }
  .sede-select-v34:focus{
    border-color:#0FA47A;
    box-shadow:0 0 0 3px rgba(15,164,122,.3);
    outline:none;
  }
  .sede-select-arrow{
    position:absolute;right:12px;top:50%;transform:translateY(-50%);
    pointer-events:none;color:#79D7BC;font-size:12px;
  }

  .nav{margin-top:12px;display:flex;flex-direction:column;gap:4px}
  .nav button{display:flex;align-items:center;gap:10px;background:transparent;color:#C9DDEA;padding:10px 12px;border-radius:10px;font-size:13.5px;font-weight:500;text-align:left;width:100%;transition:background .15s,color .15s}
  .nav button:hover{background:rgba(255,255,255,.08);color:#fff}
  .nav button.active{background:var(--vital);color:#fff;font-weight:600}
  .nav .badge{margin-left:auto;background:var(--alerta);color:#fff;font-size:11px;font-weight:700;border-radius:99px;padding:1px 8px}
  .sidebar-foot{margin-top:auto;font-size:11px;color:#9FC2D8;line-height:1.45;border-top:1px solid rgba(255,255,255,.12);padding-top:14px}

  .main{flex:1;min-width:0;padding:22px 30px 60px}
  .topbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;background:#fff;border:1px solid var(--linea);border-radius:16px;padding:12px 20px;box-shadow:var(--sombra)}
  .topbar .titulo h2{font-size:19px;color:var(--tinta)}
  .topbar .titulo p{font-size:12.5px;color:var(--texto-2)}
  .topbar .spacer{flex:1}
  .jornada-pill{display:flex;border:1.5px solid var(--linea);border-radius:99px;overflow:hidden;background:#fff}
  .jornada-pill button{padding:6px 14px;font-size:12.5px;font-weight:600;background:#fff;color:var(--texto-2)}
  .jornada-pill button.on{background:var(--tinta);color:#fff}

  /* NAVEGACIÓN GLOBAL CONSISTENTE */
  .nav-global{display:flex;align-items:center;gap:8px}
  .btn-nav-top{background:#F2F7FA;color:var(--tinta);border:1px solid var(--linea);padding:7px 12px;border-radius:9px;font-size:12.5px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
  .btn-nav-top:hover{background:var(--tinta);color:#fff;border-color:var(--tinta)}

  .grid-kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:24px}
  .kpi{background:var(--panel);border:1px solid var(--linea);border-radius:var(--radio);padding:16px;box-shadow:var(--sombra)}
  .kpi .lbl{font-size:11.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--texto-2)}
  .kpi .val{font-family:'IBM Plex Mono';font-weight:600;font-size:28px;color:var(--tinta);margin-top:4px}
  .kpi .val.alerta-c{color:var(--alerta)}
  .kpi .sub{font-size:12px;color:var(--texto-2);margin-top:2px}
  
  .panel{background:var(--panel);border:1px solid var(--linea);border-radius:var(--radio);box-shadow:var(--sombra)}
  .panel .panel-head{padding:16px 20px;border-bottom:1px solid var(--linea);display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .panel .panel-head h3{font-size:15.5px;color:var(--tinta)}
  .panel .panel-body{padding:16px 20px 20px}
  .dos-col{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;align-items:start}
  @media(max-width:1080px){.dos-col{grid-template-columns:1fr}}

  .alerta-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px dashed var(--linea)}
  .alerta-row:last-child{border-bottom:none}
  .dot{width:10px;height:10px;border-radius:50%;flex:none}
  .dot.critica{background:var(--alerta);box-shadow:0 0 0 4px var(--alerta-suave);animation:pulso 1.6s infinite}
  .dot.vigilancia{background:var(--vigilancia);box-shadow:0 0 0 4px var(--vigilancia-suave)}
  @keyframes pulso{0%,100%{transform:scale(1)}50%{transform:scale(1.25)}}
  .alerta-row .que{flex:1;min-width:0}
  .alerta-row .que b{font-size:13.5px}
  .alerta-row .que span{display:block;font-size:12px;color:var(--texto-2)}
  .alerta-row .val{font-family:'IBM Plex Mono';font-weight:600;font-size:14.5px}
  .alerta-row .val.c{color:var(--alerta)} .alerta-row .val.v{color:var(--vigilancia)}

  .bitacora{position:relative;padding-left:24px}
  .bitacora:before{content:'';position:absolute;left:8px;top:6px;bottom:6px;width:2px;background:linear-gradient(var(--linea),transparent)}
  .nota-item{position:relative;padding:12px 0 14px;border-bottom:1px dashed var(--linea)}
  .nota-item:last-child{border-bottom:none}
  .nota-item:before{content:'';position:absolute;left:-21px;top:18px;width:9px;height:9px;border-radius:50%;background:#fff;border:2.5px solid var(--vital)}
  .nota-item.tipo-novedad_salud:before{border-color:var(--vigilancia)}
  .nota-item.tipo-activacion_emergencia:before{border-color:var(--alerta)}
  .nota-meta{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:12px;color:var(--texto-2);margin-bottom:5px}
  .tag{font-size:11px;font-weight:600;border-radius:6px;padding:2px 8px;letter-spacing:.02em}
  .tag.evolucion{background:var(--vital-suave);color:#0A7A5A}
  .tag.ingreso{background:#E8F0F6;color:var(--tinta)}
  .tag.novedad_salud{background:var(--vigilancia-suave);color:#9A6A14}
  .tag.administracion_medicamento{background:#EEEAF8;color:#5B4A9E}
  .tag.activacion_emergencia{background:var(--alerta-suave);color:var(--alerta)}
  .tag.actividad_salud{background:#E6F4F8;color:#11697F}
  .tag.general_jornada{background:#EEF2F4;color:var(--texto-2)}
  .nota-txt{font-size:14px}
  .nota-signos{margin-top:7px;display:flex;flex-wrap:wrap;gap:6px}
  .chip-signo{font-family:'IBM Plex Mono';font-size:12px;font-weight:600;border-radius:7px;padding:3px 8px;background:#F2F7FA;border:1px solid var(--linea);color:var(--texto)}
  .chip-signo.v{background:var(--vigilancia-suave);border-color:#EDD8AE;color:#9A6A14}
  .chip-signo.c{background:var(--alerta-suave);border-color:#F2C4B6;color:var(--alerta)}
  .badge-e2ee{background:var(--cifrado-suave);color:var(--cifrado);border:1px solid #C7D2FE;padding:2px 7px;border-radius:6px;font-weight:600;font-size:10.5px}
  .badge-hash{background:#EEF2F4;color:var(--texto-2);border:1px solid var(--linea);padding:2px 7px;border-radius:6px;font-family:'IBM Plex Mono';font-size:10.5px}

  .buscador{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap}
  .buscador input{flex:1;min-width:220px;padding:11px 14px;border:1.5px solid var(--linea);border-radius:11px;background:#fff}
  .grid-res{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
  .res-card{background:#fff;border:1px solid var(--linea);border-radius:var(--radio);padding:16px;box-shadow:var(--sombra);text-align:left;transition:transform .12s,box-shadow .15s,border-color .15s}
  .res-card:hover{transform:translateY(-2px);border-color:var(--vital);box-shadow:0 10px 28px -12px rgba(14,58,93,.25)}
  .res-card .top{display:flex;gap:11px;align-items:center;margin-bottom:10px}
  .res-card .nom{font-weight:600;font-size:14.5px;line-height:1.2}
  .res-card .doc{font-size:12px;color:var(--texto-2);font-weight:500}
  .res-card .dx{font-size:12px;color:var(--texto-2);margin-bottom:10px;min-height:18px}
  .res-card .pie{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--texto-2)}
  .estado-pill{font-size:11px;font-weight:700;border-radius:99px;padding:3px 10px;display:inline-flex;align-items:center;gap:4px}
  .estado-pill.ok{background:var(--vital-suave);color:#0A7A5A}
  .estado-pill.v{background:var(--vigilancia-suave);color:#9A6A14}
  .estado-pill.c{background:var(--alerta-suave);color:var(--alerta)}
  .estado-pill.inactivo{background:#F3F4F6;color:#6B7280;border:1px solid #E5E7EB}

  .ficha-head{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-bottom:20px}
  .avatar-xl{width:56px;height:56px;border-radius:16px;background:var(--tinta);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Sora';font-weight:700;font-size:20px}
  .ficha-head h2{font-size:20px;color:var(--tinta)}
  .ficha-head .meta{font-size:13px;color:var(--texto-2)}
  .grid-signos{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:22px}
  .signo-card{background:#fff;border:1px solid var(--linea);border-radius:var(--radio);padding:14px 15px;box-shadow:var(--sombra);position:relative;overflow:hidden}
  .signo-card .lbl{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--texto-2)}
  .signo-card .num{font-family:'IBM Plex Mono';font-weight:600;font-size:24px;margin-top:5px;color:var(--tinta)}
  .signo-card .num small{font-size:12px;color:var(--texto-2);font-weight:500}
  .signo-card.v .num{color:#B07914}.signo-card.c .num{color:var(--alerta)}
  .signo-card.na .num{color:var(--texto-2);font-size:17px;padding-top:6px}
  .signo-card .borde{position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--vital)}
  .signo-card.v .borde{background:var(--vigilancia)}.signo-card.c .borde{background:var(--alerta)}
  .signo-card.na .borde{background:#C7D4DB}

  .form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
  .form-grid .full{grid-column:1/-1}
  .campo-signo{position:relative}
  .campo-signo .estado{position:absolute;right:10px;top:34px;font-size:10.5px;font-weight:700;border-radius:6px;padding:2px 7px}
  .campo-signo .estado.ok{background:var(--vital-suave);color:#0A7A5A}
  .campo-signo .estado.v{background:var(--vigilancia-suave);color:#9A6A14}
  .campo-signo .estado.c{background:var(--alerta-suave);color:var(--alerta)}
  .form-foot{display:flex;gap:12px;align-items:center;margin-top:20px;flex-wrap:wrap}

  /* RANGOS DE SEGURIDAD CLÍNICA - V3.1 CARTA/BANNER */
  .banner-rangos-v31{
    background:linear-gradient(135deg, #F0F9FF 0%, #E6F4F8 100%);
    border:1px solid #BAE6FD;
    border-radius:14px;
    padding:16px 18px;
    margin-top:18px;
    font-size:13px;
    color:#0369A1;
    line-height:1.5;
  }
  .banner-rangos-v31 b{color:#075985}
  .grid-rangos-items{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));
    gap:8px 14px;
    margin-top:10px;
  }
  .rango-item-tag{
    background:#FFFFFF;
    border:1px solid #E0F2FE;
    border-radius:8px;
    padding:6px 10px;
    font-size:12px;
    box-shadow:0 1px 2px rgba(3,105,161,.05);
  }

  .nota-aviso{font-size:12.5px;color:var(--texto-2);display:flex;gap:7px;align-items:flex-start;background:#F2F7FA;border:1px solid var(--linea);border-radius:10px;padding:10px 13px;margin-top:14px}
  .nota-aviso.rojo{background:var(--alerta-suave);border-color:#F2C4B6;color:#8C3018}
  .nota-aviso.cifrado{background:var(--cifrado-suave);border-color:#C7D2FE;color:#3730A3}

  /* MODALES Y OVERLAYS */
  .overlay{position:fixed;inset:0;background:rgba(14,58,93,.45);display:flex;align-items:center;justify-content:center;padding:20px;z-index:110;animation:fade .15s}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  .modal{background:#fff;border-radius:18px;box-shadow:0 24px 64px -16px rgba(14,58,93,.4);width:100%;max-width:680px;max-height:90vh;overflow-y:auto;padding:28px}
  .modal h3{color:var(--tinta);font-size:19px;margin-bottom:4px}
  .modal .sub{font-size:13px;color:var(--texto-2);margin-bottom:18px}
  .modal-foot{display:flex;gap:10px;justify-content:flex-end;margin-top:20px;flex-wrap:wrap}
  .legal-box{background:#F8FAFC;border:1px solid var(--linea);border-radius:10px;padding:16px;font-size:12.5px;color:var(--texto);max-height:220px;overflow-y:auto;line-height:1.5;margin-bottom:14px}
  .legal-box h4{font-size:13px;color:var(--tinta);margin:10px 0 4px}

  /* SWITCH */
  .switch-row{display:flex;align-items:flex-start;gap:14px;padding:14px 0;border-bottom:1px dashed var(--linea)}
  .switch-row:last-child{border-bottom:none}
  .switch-row .info{flex:1}
  .switch-row .info b{font-size:14.5px}
  .switch-row .info p{font-size:12.5px;color:var(--texto-2);margin-top:2px}
  .switch{position:relative;width:46px;height:26px;flex:none;background:#C7D4DB;border-radius:99px;transition:background .15s;padding:0}
  .switch.on{background:var(--vital)}
