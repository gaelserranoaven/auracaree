                        <option value="ambos">☀/☾ Día y Noche (24/7)</option>
                        <option value="dia">☀ Solo Día</option>
                        <option value="noche">☾ Solo Noche</option>
                      </select>
                    </td>
                    <td>
                      <span className={'estado-pill ' + st.cls}>{st.label}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};

