        <div className="form-grid">
          <div className="field"><label>Nombres *</label><input value={f.nombres} onChange={e=>set('nombres',e.target.value)} /></div>
          <div className="field"><label>Apellidos *</label><input value={f.apellidos} onChange={e=>set('apellidos',e.target.value)} /></div>
          <div className="field"><label>Cédula / Documento *</label><input value={f.numDoc} onChange={e=>set('numDoc',e.target.value)} placeholder="Número de cédula o ID" /></div>
          <div className="field"><label>Edad</label><input type="number" value={f.edad} onChange={e=>set('edad',e.target.value)} /></div>
          <div className="field full"><label>Diagnósticos base</label><input value={f.dx} onChange={e=>set('dx',e.target.value)} /></div>
        </div>
        <div className="modal-foot">
          <button className="btn btn-ghost" onClick={cerrar}>Cancelar</button>
          <button className="btn btn-primary" disabled={!f.nombres.trim() || !f.apellidos.trim()} onClick={()=>onCrear(f)}>Registrar Persona Mayor</button>
        </div>
      </div>
    </div>
  );
};

/* ============================ RESIDENTES (CON FILTRADO INSTANTÁNEO POR CÉDULA V3.4) ============================ */
const Residentes = ({ residentes, irFicha, abrirNuevo, abrirImport }) => {
  const [q, setQ] = useState('');
  const filtrados = residentes.filter(r => 
    (r.nombres + ' ' + r.apellidos + ' ' + r.doc).toLowerCase().includes(q.toLowerCase())
  );

  return (
    <div>
      <div className="buscador">
        <input 
          placeholder="🔍 Escribe la CÉDULA o nombre de la persona mayor para filtrar de una..." 
          value={q} 
          onChange={e=>setQ(e.target.value)} 
          style={{fontSize:'14.5px',borderColor: q ? 'var(--vital)' : 'var(--linea)'}}
        />
        <button className="btn btn-ghost" onClick={abrirImport}>⬆ Importar Excel</button>
        <button className="btn btn-primary" onClick={abrirNuevo}>+ Nuevo residente</button>
      </div>
      {q && <div style={{fontSize:'13px',color:'var(--texto-2)',marginBottom:'14px'}}>Filtrando por: <b>"{q}"</b> ({filtrados.length} resultado(s))</div>}
      <div className="grid-res">
        {filtrados.map(r => (
          <button key={r.id} className="res-card" onClick={() => irFicha(r.id)}>
            <div className="top">
              <div className="avatar" aria-hidden="true">{r.nombres[0]}{r.apellidos[0]}</div>
              <div>
                <div className="nom">{r.nombres} {r.apellidos}</div>
                <div className="doc">🪪 {r.doc} · {r.edad ? r.edad + ' años' : 's/r'}</div>
              </div>
            </div>
            <div className="dx">{r.dx}</div>
            <div className="pie">
              <span className="estado-pill ok">Activo</span>
              <span style={{marginLeft:'auto'}}>Ver ficha →</span>
            </div>
          </button>
        ))}
        {filtrados.length === 0 && (
          <div className="vacio" style={{gridColumn:'1/-1',background:'#fff',borderRadius:'14px',border:'1px solid var(--linea)'}}>
            No se encontró ninguna persona mayor con la cédula o nombre <b>"{q}"</b>.
          </div>
        )}
      </div>
    </div>
  );
};

/* ============================ FICHA RESIDENTE ============================ */
const Ficha = ({ res, notas, config, volver, nuevaNotaPara }) => {
  const s = res.signos || {};
  const h = res.hist || {};
  const cards = [
    { lbl:'Tensión arterial', val: s.ta_s ? s.ta_s + '/' + s.ta_d : '—', uni:'mmHg', hist: h.ta_s },
    { lbl:'Frec. cardiaca', val: s.fc ?? '—', uni:'lpm', hist: h.fc },
    { lbl:'Saturación O₂', val: s.spo2 ?? '—', uni:'%', hist: h.spo2 },
    { lbl:'Frec. respiratoria', val: s.fr ?? '—', uni:'rpm' },
    { lbl:'Temperatura', val: s.temp ?? '—', uni:'°C' },
    config.glu ? { lbl:'Glucometría', val: s.glu ?? '—', uni:'mg/dL' } : { lbl:'Glucometría', val:'No aplica', uni:'' },
  ];
  const notasRes = notas.filter(n => n.personaId === res.id);

  return (
    <div>
      <div className="ficha-head">
        <div className="avatar-xl" aria-hidden="true">{res.nombres[0]}{res.apellidos[0]}</div>
        <div>
          <h2>{res.nombres} {res.apellidos}</h2>
          <div className="meta">🪪 {res.doc} · {res.edad ? res.edad + ' años' : 's/r'} · {res.dx}</div>
        </div>
        <div style={{marginLeft:'auto'}}>
          <button className="btn btn-primary" onClick={() => nuevaNotaPara(res.id)}>+ Nueva nota</button>
        </div>
      </div>

      <div className="grid-signos">
        {cards.map(c => (
          <div key={c.lbl} className="signo-card">
            <span className="borde" aria-hidden="true"></span>
            <div className="lbl">{c.lbl}</div>
            <div className="num">{c.val} <small>{c.uni}</small></div>
            {c.hist && <Sparkline data={c.hist} estado="ok" />}
          </div>
        ))}
      </div>

      <div className="panel">
        <div className="panel-head"><h3>Bitácora de salud (solo lectura · append-only)</h3></div>
        <div className="panel-body">
          {notasRes.length === 0 ? <div className="vacio">Esta persona aún no tiene notas registradas.</div> :
          <div className="bitacora">
            {[...notasRes].reverse().map(n => (
              <div key={n.id} className={'nota-item tipo-' + n.tipo}>
                <div className="nota-meta">
                  <span className="mono">{fmtFecha(n.fecha)} · {n.hora}</span>
                  <span className={'tag ' + n.tipo}>{TIPO_LBL[n.tipo]}</span>
                  <span className="badge-e2ee">E2EE AES-256</span>
                  <span className="badge-hash">#SHA:{n.hash || '8f2a991b'}</span>
                </div>
                <div className="nota-txt">{n.descripcion}</div>
                <ChipsSignos signos={n.signos} />
                <div className="nota-autor" style={{marginTop:'6px'}}>Registró: {n.autor}</div>
              </div>
            ))}
          </div>}
        </div>
      </div>
    </div>
  );
};

/* ============================ NUEVA NOTA CON RANGOS CLÍNICOS V3.1 EN BANNER Y BÚSQUEDA DE CÉDULA V3.4 ============================ */
const NuevaNota = ({ sede, residentes, jornada, presel, config, onGuardar }) => {
  const [personaId, setPersonaId] = useState(presel || '');
  const [filtroCedula, setFiltroCedula] = useState('');
  const [tipo, setTipo] = useState('evolucion');
  const [desc, setDesc] = useState('');
  const [sv, setSv] = useState({ ta_s:'', ta_d:'', fc:'', fr:'', temp:'', spo2:'', glu:'', dolor:'' });
  const set = (k,v) => setSv(p=>({...p,[k]:v}));

  const residentesFiltrados = residentes.filter(r => 
    (r.nombres + ' ' + r.apellidos + ' ' + r.doc).toLowerCase().includes(filtroCedula.toLowerCase())
  );

  const personaSelObj = residentes.find(r => r.id === personaId);

  const guardar = () => {
    if(desc.trim().length < 10) return;
    const signos = {};
    Object.keys(sv).forEach(k => { if(sv[k] !== '') signos[k] = Number(sv[k]); });
    onGuardar({ personaId: personaId || null, tipo, descripcion: desc.trim(), signos });
  };

  const campos = [
    ['ta_s','TA sistólica (mmHg)'],
    ['ta_d','TA diastólica (mmHg)'],
    ['fc','Frec. cardiaca (lpm)'],
    ['fr','Frec. respiratoria (rpm)'],
    ['temp','Temperatura (°C)'],
    ['spo2','Saturación O₂ (%)'],
  ];
  if(config.glu) campos.push(['glu','Glucometría (mg/dL)']);

  return (
    <div className="panel" style={{maxWidth:'880px'}}>
      <div className="panel-head"><h3>Nueva Nota Médica · {sede.nombre} · Jornada {jornada === 'dia' ? 'Día' : 'Noche'}</h3></div>
      <div className="panel-body">
        
        {/* BUSCADOR DE PERSONA MAYOR POR CÉDULA (NUEVO V3.4) */}
        <div className="picker-persona-v34">
          <label style={{fontSize:'12.5px',fontWeight:700,color:'var(--tinta)',display:'block',marginBottom:'6px'}}>
            🔎 Buscar y Seleccionar Persona Mayor por Cédula o Nombre:
          </label>
          <input 
            placeholder="Escriba la cédula o el nombre para filtrar al instante..." 
            value={filtroCedula} 
            onChange={e=>setFiltroCedula(e.target.value)} 
          />
          <div className="picker-res-list">
            <div 
              className={'picker-res-item ' + (personaId === '' ? 'selected' : '')}
              onClick={()=>setPersonaId('')}
            >
              <span>📢 Novedad General de la Jornada (Sin persona específica)</span>
              <span>{personaId === '' ? '✓ Seleccionado' : ''}</span>
            </div>
            {residentesFiltrados.map(r => (
              <div 
                key={r.id} 
                className={'picker-res-item ' + (personaId === r.id ? 'selected' : '')}
                onClick={()=>setPersonaId(r.id)}
              >
                <span><b>{r.nombres} {r.apellidos}</b> — <span className="mono">🪪 {r.doc}</span></span>
                <span>{personaId === r.id ? '✓ Seleccionado' : 'Seleccionar'}</span>
              </div>
            ))}
          </div>
          {personaSelObj && (
            <div style={{marginTop:'8px',fontSize:'13px',color:'var(--vital)',fontWeight:600}}>
              Persona mayor seleccionada: {personaSelObj.nombres} {personaSelObj.apellidos} ({personaSelObj.doc})
            </div>
          )}
        </div>

        <div className="form-grid">
          <div className="field full">
            <label>Tipo de nota</label>
            <select value={tipo} onChange={e=>setTipo(e.target.value)}>
              {TIPOS_NOTA.map(([v,l]) => <option key={v} value={v}>{l}</option>)}
            </select>
          </div>

          {campos.map(([k, lbl]) => {
            const e = estadoSigno(k, sv[k]);
            return (
              <div key={k} className="field campo-signo">
                <label>{lbl}</label>
                <input type="number" step="any" value={sv[k]} onChange={ev=>set(k, ev.target.value)} placeholder="—" />
                {e && <span className={'estado ' + e}>{e==='ok'?'EN RANGO':e==='v'?'VIGILANCIA':'CRÍTICO'}</span>}
              </div>
            );
          })}

          <div className="field full">
            <label>Descripción de la novedad (mínimo 10 caracteres)</label>
            <textarea rows="4" value={desc} onChange={e=>setDesc(e.target.value)} placeholder="Escriba la valoración clínica o conducta observada…"></textarea>
          </div>
        </div>

        {/* RANGOS DE SEGURIDAD CLÍNICA - RESTAURADOS AL ESTILO V3.1 (CUADRO/BANNER INFORMATIVO AL FINAL) */}
        <div className="banner-rangos-v31">
          <b>🩺 Rangos de Seguridad y Clínica (Estándar OMS / Fundación):</b>
          <div className="grid-rangos-items">
            {Object.entries(RANGOS).filter(([k]) => k !== 'glu' || config.glu).map(([k,r]) => (
              <div key={k} className="rango-item-tag">
                <b>{r.lbl}:</b><br/>
                <span style={{color:'var(--vital)'}}>Normal: {r.normal} {r.uni}</span><br/>
                <span style={{color:'var(--vigilancia)'}}>Vig: {r.vig}</span> · <span style={{color:'var(--alerta)'}}>Crit: {r.crit}</span>
              </div>
            ))}
          </div>
        </div>

        <div className="form-foot">
          <button className="btn btn-primary" disabled={desc.trim().length < 10} onClick={guardar}>Guardar Nota Firmada E2EE (v3.4)</button>
        </div>
      </div>
    </div>
  );
};

/* ============================ ASISTENCIA & ACTIVIDADES ============================ */
const Asistencia = ({ sede, residentes, asistencias, setAsist, actividades, setActs, jornada, avisar }) => {
  const [fAct, setFAct] = useState({ nombre:'', linea:'', profesional:'' });
  const llave = rid => sede.id + '|' + hoyISO + '|' + rid;
  const marcar = (rid, estado, motivo) => {
    setAsist(prev => ({...prev, [llave(rid)]:{ estado, motivo: motivo || '' }}));
  };

  const crearAct = () => {
    if(!fAct.nombre || !fAct.linea || !fAct.profesional) return;
    setActs(prev => [...prev, { id:'ac' + Date.now(), sedeId:sede.id, fecha:hoyISO, ...fAct, participacion:{} }]);
    setFAct({ nombre:'', linea:'', profesional:'' });
    avisar('Actividad agregada ✓');
  };

  return (
    <div>
      <div className="topbar no-print" style={{marginBottom:'16px'}}>
        <div className="titulo"><p>Sección 5 SDIS · Registro de asistencia a la unidad operativa</p></div>
        <div className="spacer"></div>
        <button className="btn btn-tinta" onClick={() => window.print()}>⬇ Exportar Sección 5 (PDF)</button>
      </div>

      <div className="dos-col">
        <div className="panel no-print">
          <div className="panel-head"><h3>Ingreso de residentes hoy</h3></div>
          <div className="panel-body">
            <table className="op">
              <thead><tr><th>Persona mayor</th><th>Firma / Motivo</th></tr></thead>
              <tbody>
                {residentes.map(r => {
                  const a = asistencias[llave(r.id)];
                  return (
                    <tr key={r.id}>
                      <td><b>{r.nombres} {r.apellidos}</b><br/><span style={{fontSize:'12px',color:'var(--texto-2)'}}>🪪 {r.doc}</span></td>
                      <td>
                        <span className="seg">
                          <button className={a?.estado === 'firma' ? 'si' : ''} onClick={() => marcar(r.id,'firma')}>Firma</button>
                          <button className={a?.estado === 'no_firma' ? 'nf' : ''} onClick={() => marcar(r.id,'no_firma', a?.motivo || MOTIVOS_NF[0])}>No firma</button>
                        </span>
                        {a?.estado === 'no_firma' && (
                          <select style={{marginLeft:'6px',padding:'4px',fontSize:'12px'}} value={a.motivo} onChange={e=>marcar(r.id,'no_firma',e.target.value)}>
                            {MOTIVOS_NF.map(m => <option key={m}>{m}</option>)}
                          </select>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <div className="panel no-print">
          <div className="panel-head"><h3>Actividades comunitarias hoy</h3></div>
          <div className="panel-body">
            <div className="form-grid" style={{gridTemplateColumns:'1fr',gap:'10px'}}>
              <div className="field" style={{marginBottom:0}}><label>Nombre de actividad</label><input value={fAct.nombre} onChange={e=>setFAct(p=>({...p,nombre:e.target.value}))} placeholder="Taller de estimulación" /></div>
              <div className="field" style={{marginBottom:0}}><label>Línea de atención</label><input value={fAct.linea} onChange={e=>setFAct(p=>({...p,linea:e.target.value}))} placeholder="Envejecimiento activo" /></div>
              <div className="field" style={{marginBottom:0}}><label>Profesional a cargo</label><input value={fAct.profesional} onChange={e=>setFAct(p=>({...p,profesional:e.target.value}))} placeholder="Nombre del tallerista" /></div>
              <button className="btn btn-primary" onClick={crearAct} disabled={!fAct.nombre || !fAct.linea || !fAct.profesional}>+ Crear Actividad</button>
            </div>
          </div>
        </div>
      </div>

      <div id="zona-print" className="print-only">
        <div className="sdis">
          <SdisHead titulo="SECCIÓN 5. REGISTRO DE PARTICIPACIÓN EN ACTIVIDADES" sede={sede} jornada={jornada} />
          <table className="sdis-tabla">
            <thead><tr><th>Documento</th><th>Nombres</th><th>Firma</th><th>Observaciones</th></tr></thead>
            <tbody>
              {residentes.map(r => {
                const a = asistencias[llave(r.id)];
                return (
                  <tr key={r.id}>
                    <td>{r.doc}</td><td>{r.nombres} {r.apellidos}</td>
                    <td>{a?.estado === 'firma' ? 'Firma Electrónica' : 'NO FIRMA'}</td>
                    <td>{a?.estado === 'no_firma' ? a.motivo : ''}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <LeySdis />
        </div>
      </div>
    </div>
  );
};

/* ============================ DOTACIÓN & PERTENENCIAS ============================ */
const Dotacion = ({ sede, residentes, entregas, setEntregas, pertenencias, setPert, avisar }) => {
  const [tab, setTab] = useState('aseo');
  const [fE, setFE] = useState({ personaId:'', elemento:'DESODORANTE', cantidad:1, obs:'' });
  const [fP, setFP] = useState({ personaId:'', ayudas:'', prendas:'', lenceria:'', otros:'', obs:'' });

  const entregasMes = entregas.filter(e => e.sedeId === sede.id && e.fecha.slice(0,7) === mesActual);
  const registrarEntrega = () => {
    if(!fE.personaId) return;
    setEntregas(prev => [...prev, { id:'e'+Date.now(), sedeId:sede.id, personaId:fE.personaId, elemento:fE.elemento, cantidad:Number(fE.cantidad), fecha:hoyISO, quien:'Claudia M. Ríos', obs:fE.obs }]);
    setFE({ personaId:'', elemento:'DESODORANTE', cantidad:1, obs:'' });
    avisar('Entrega registrada ✓');
  };

  const registrarPert = () => {
    if(!fP.personaId) return;
    setPert(prev => [...prev, { id:'p'+Date.now(), sedeId:sede.id, personaId:fP.personaId, ayudas:fP.ayudas, prendas:fP.prendas, lenceria:fP.lenceria, otros:fP.otros, obs:fP.obs, fechaRecibo:hoyISO, estado:'en_custodia', fechaDev:null }]);
    setFP({ personaId:'', ayudas:'', prendas:'', lenceria:'', otros:'', obs:'' });
    avisar('Pertenencias registradas en custodia ✓');
  };

  const nombreDe = id => { const r = residentes.find(x=>x.id===id); return r ? r.nombres + ' ' + r.apellidos : '—'; };
  const pertsSede = pertenencias.filter(p => p.sedeId === sede.id);

  return (
    <div>
      <div className="tabs no-print">
        <button className={tab==='aseo'?'on':''} onClick={()=>setTab('aseo')}>Aseo y prendas · Sección 1</button>
        <button className={tab==='pert'?'on':''} onClick={()=>setTab('pert')}>Pertenencias ingreso · Sección 4</button>
      </div>

      {tab === 'aseo' && (
        <div className="dos-col">
          <div className="panel no-print">
            <div className="panel-head"><h3>Registrar Entrega de Dotación</h3></div>
            <div className="panel-body">
              <div className="form-grid" style={{gridTemplateColumns:'1fr',gap:'10px'}}>
                <div className="field" style={{marginBottom:0}}><label>Persona mayor</label>
                  <select value={fE.personaId} onChange={e=>setFE(p=>({...p,personaId:e.target.value}))}>
                    <option value="">Seleccionar…</option>
                    {residentes.map(r => <option key={r.id} value={r.id}>{r.nombres} {r.apellidos} ({r.doc})</option>)}
                  </select></div>
                <div className="field" style={{marginBottom:0}}><label>Elemento</label>
                  <select value={fE.elemento} onChange={e=>setFE(p=>({...p,elemento:e.target.value}))}>
                    {ELEMENTOS.map(el => <option key={el.key} value={el.key}>{el.nombre}</option>)}
                  </select></div>
                <div className="field" style={{marginBottom:0}}><label>Cantidad</label>
                  <input type="number" min="1" value={fE.cantidad} onChange={e=>setFE(p=>({...p,cantidad:e.target.value}))} /></div>
                <button className="btn btn-primary" disabled={!fE.personaId} onClick={registrarEntrega}>Registrar Entrega</button>
              </div>
            </div>
          </div>

          <div className="panel no-print">
            <div className="panel-head"><h3>Consolidado Entregas del Mes</h3></div>
            <div className="panel-body">
              {entregasMes.length === 0 ? <div className="vacio">Sin entregas este mes.</div> :
              <table className="op">
                <thead><tr><th>Fecha</th><th>Persona</th><th>Elemento</th><th>Cant</th></tr></thead>
                <tbody>{entregasMes.map(e => <tr key={e.id}><td>{e.fecha}</td><td>{nombreDe(e.personaId)}</td><td>{EL_LBL[e.elemento]}</td><td>{e.cantidad}</td></tr>)}</tbody>
              </table>}
            </div>
          </div>
        </div>
      )}

      {tab === 'pert' && (
        <div className="dos-col">
          <div className="panel">
            <div className="panel-head"><h3>Registrar pertenencias al ingreso</h3></div>
            <div className="panel-body">
              <div className="form-grid" style={{gridTemplateColumns:'1fr',gap:'10px'}}>
                <div className="field" style={{marginBottom:0}}><label>Persona mayor</label>
                  <select value={fP.personaId} onChange={e=>setFP(p=>({...p,personaId:e.target.value}))}>
                    <option value="">Seleccionar…</option>
                    {residentes.map(r => <option key={r.id} value={r.id}>{r.nombres} {r.apellidos} ({r.doc})</option>)}
                  </select></div>
                <div className="field" style={{marginBottom:0}}><label>Ayudas técnicas</label>
                  <input value={fP.ayudas} onChange={e=>setFP(p=>({...p,ayudas:e.target.value}))} placeholder="Bastón, caminador…" /></div>
                <div className="field" style={{marginBottom:0}}><label>Prendas de vestir</label>
                  <input value={fP.prendas} onChange={e=>setFP(p=>({...p,prendas:e.target.value}))} placeholder="Prendas de vestir" /></div>
                <div className="field" style={{marginBottom:0}}><label>Otros elementos</label>
                  <input value={fP.otros} onChange={e=>setFP(p=>({...p,otros:e.target.value}))} placeholder="Objetos de valor o uso personal" /></div>
                <button className="btn btn-primary" disabled={!fP.personaId} onClick={registrarPert}>Registrar en Custodia</button>
              </div>
            </div>
          </div>

          <div className="panel">
            <div className="panel-head"><h3>Custodia y Devoluciones</h3></div>
            <div className="panel-body">
              {pertsSede.length === 0 ? <div className="vacio">Sin pertenencias registradas.</div> :
              pertsSede.map(p => (
                <div key={p.id} style={{padding:'10px 0',borderBottom:'1px dashed var(--linea)'}}>
                  <b>{nombreDe(p.personaId)}</b> - <span style={{fontSize:'12px',color:'var(--vital)'}}>En custodia</span>
                  <div style={{fontSize:'12px',color:'var(--texto-2)'}}>Prendas: {p.prendas || '—'} · Ayudas: {p.ayudas || '—'} · Otros: {p.otros || '—'}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

/* ============================ ENTREGA DE TURNO ============================ */
const EntregaTurno = ({ sede, jornada, residentes, notas, alertas, usuario }) => {
  const [obsTurno, setObsTurno] = useState('');
  const [firmado, setFirmado] = useState(false);

  return (
    <div className="panel" style={{maxWidth:'880px'}}>
      <div className="panel-head"><h3>Acta Criptográfica de Entrega de Turno · {sede.nombre}</h3></div>
      <div className="panel-body">
        <div className="form-grid">
          <div className="field"><label>Jornada que entrega</label><input value={jornada === 'dia' ? 'Día (06:00 - 18:00)' : 'Noche (18:00 - 06:00)'} disabled style={{background:'#EEF2F4'}} /></div>
          <div className="field"><label>Profesional Responsable</label><input value={usuario.nombre} disabled style={{background:'#EEF2F4'}} /></div>
          <div className="field full"><label>Observaciones generales para el equipo entrante</label>
            <textarea rows="3" value={obsTurno} onChange={e=>setObsTurno(e.target.value)} placeholder="Pendientes de salud, citas médicas, recomendaciones…"></textarea>
          </div>
        </div>
        <div className="form-foot">
          {!firmado ? <button className="btn btn-primary" onClick={() => setFirmado(true)} disabled={!obsTurno.trim()}>Firmar Cierre de Turno</button> :
          <div className="nota-aviso cifrado"><span>🔒 Turno cerrado y firmado electrónicamente por {usuario.nombre} el {fmtFecha(hoyISO)}.</span></div>}
        </div>
      </div>
    </div>
  );
};

/* ============================ REGISTRO SDIS ============================ */
const RegistroSdis = ({ sede, notas, residentes, jornada }) => {
  const filas = notas.filter(n => n.fecha === hoyISO && n.sedeId === sede.id);
  const nombreDe = id => { const r = residentes.find(x=>x.id===id); return r ? r.nombres + ' ' + r.apellidos + ': ' : ''; };

  return (
    <div>
      <div className="topbar no-print" style={{marginBottom:'16px'}}>
        <div className="titulo"><p>Sección 6 SDIS · Registro Diario Novedades Salud (FOR-PSS-729)</p></div>
        <div className="spacer"></div>
        <button className="btn btn-tinta" onClick={() => window.print()}>⬇ Exportar PDF para Interventoría</button>
      </div>
      <div id="zona-print">
        <div className="sdis">
          <SdisHead titulo="SECCIÓN 6. REGISTRO DIARIO NOVEDADES SALUD" sede={sede} jornada={jornada} />
          <table className="sdis-tabla">
            <thead><tr><th>Fecha</th><th>Hora</th><th>Descripción Novedades de Salud</th><th>Firma / Autor</th></tr></thead>
            <tbody>
              {filas.map(n => (
                <tr key={n.id}>
                  <td className="mono">{n.fecha}</td>
                  <td className="mono">{n.hora}</td>
                  <td>{nombreDe(n.personaId)}{n.descripcion}</td>
                  <td>{n.autor}<br/><small style={{color:'#666'}}>Hash SHA: {n.hash||'8f2a991b'}</small></td>
                </tr>
              ))}
            </tbody>
          </table>
          <LeySdis />
        </div>
      </div>
    </div>
  );
};

/* ============================ CONFIGURACIÓN DE LA UNIDAD & NUEVA SEDE (ESTILO V3.4 MODERNIZADO) ============================ */
const Config = ({ sedes, setSedes, sede, config, setConfig, avisar, residentes }) => {
  const [nuevaSede, setNuevaSede] = useState({ nombre:'', cupos:40 });

  const toggle = k => {
    setConfig(prev => ({...prev, [sede.id]: {...prev[sede.id], [k]: !prev[sede.id][k]}}));
    avisar('Configuración guardada ✓');
  };

  const agregarSede = () => {
    if(!nuevaSede.nombre.trim()) return;
    const id = 'sede_' + Date.now();
    const nueva = { id, nombre: nuevaSede.nombre.trim(), cupos: Number(nuevaSede.cupos) || 30 };
    setSedes(prev => [...prev, nueva]);
    setConfig(prev => ({...prev, [id]: { glu:true, dolor:true }}));
    setNuevaSede({ nombre:'', cupos:40 });
    avisar(`Nueva unidad operativa "${nueva.nombre}" agregada ✓`);
  };

  return (
    <div style={{display:'flex',flexDirection:'column',gap:'20px',maxWidth:'840px'}}>
      <div className="panel">
        <div className="panel-head"><h3>Parámetros Clínicos · {sede.nombre}</h3></div>
        <div className="panel-body">
          <div className="switch-row">
            <div className="info"><b>Glucometría</b><p>Habilita el campo de toma de glucosa en sangre en los formularios de notas.</p></div>
            <button className={'switch' + (config.glu ? ' on' : '')} onClick={() => toggle('glu')}></button>
          </div>
          <div className="switch-row">
            <div className="info"><b>Escala de Dolor (0-10)</b><p>Valoración de dolor crónico en notas diarias.</p></div>
            <button className={'switch' + (config.dolor ? ' on' : '')} onClick={() => toggle('dolor')}></button>
          </div>
        </div>
      </div>

      {/* SECCIÓN UNIDADES OPERATIVAS MODERNIZADA V3.4 */}
      <div className="panel">
        <div className="panel-head"><h3>🏢 Unidades Operativas Registradas (Vista Modernizada v3.4)</h3></div>
        <div className="panel-body">
          <p className="sub" style={{fontSize:'12.5px',color:'var(--texto-2)',marginBottom:'14px'}}>
            Centros de protección social habilitados con seguimiento de cupos y turno activo.
          </p>

          <div className="grid-sedes-v34">
            {sedes.map(s => {
              const resEnSede = residentes.filter(r => r.sedeId === s.id).length;
              const pct = Math.min(100, Math.round((resEnSede / s.cupos) * 100));
              return (
                <div key={s.id} className="card-sede-v34">
                  <h4>🏢 {s.nombre}</h4>
                  <div style={{fontSize:'12px',color:'var(--texto-2)'}}>Cupos utilizados: <b>{resEnSede} de {s.cupos}</b> ({pct}%)</div>
                  <div className="cupo-bar-bg"><div className="cupo-bar-fill" style={{width:`${pct}%`}}></div></div>
                  <span className="estado-pill ok" style={{fontSize:'10px',marginTop:'4px'}}>🟢 Operativa 24/7</span>
                </div>
              );
            })}
          </div>

          <div style={{marginTop:'22px',borderTop:'1px dashed var(--linea)',paddingTop:'16px'}}>
            <b style={{fontSize:'14px'}}>+ Registrar Nueva Unidad Operativa:</b>
            <div className="form-grid" style={{gridTemplateColumns:'1fr 130px',gap:'10px',marginTop:'10px'}}>
              <div className="field" style={{marginBottom:0}}>
                <label>Nombre de la Nueva Sede *</label>
                <input value={nuevaSede.nombre} onChange={e=>setNuevaSede(p=>({...p,nombre:e.target.value}))} placeholder="Ej: Sede Suba - Centro de Cuidado" />
              </div>
              <div className="field" style={{marginBottom:0}}>
                <label>Cupos *</label>
                <input type="number" min="1" value={nuevaSede.cupos} onChange={e=>setNuevaSede(p=>({...p,cupos:e.target.value}))} />
              </div>
            </div>
            <button className="btn btn-primary" style={{marginTop:'12px'}} disabled={!nuevaSede.nombre.trim()} onClick={agregarSede}>+ Agregar Sede al Sistema</button>
          </div>
        </div>
      </div>
    </div>
  );
};

/* ============================ APP PRINCIPAL ============================ */
const App = () => {
  const [pantalla, setPantalla] = useState('login');
  const [view, setView] = useState('panel');
  const [navStack, setNavStack] = useState(['panel']);
  
  const [sedes, setSedes] = useState(SEDES_INI);
  const [sedeId, setSedeId] = useState('cund');
  const [jornada, setJornada] = useState('dia');

  const [usuarios, setUsuarios] = useState(USUARIOS_BD);
  const [usuarioActivo, setUsuarioActivo] = useState(USUARIOS_BD.find(u => u.rolId === 'superadmin'));
  const [rolActivo, setRolActivo] = useState(ROLES.find(r => r.id === 'superadmin'));
  const [secretPass, setSecretPass] = useState('••••••••••');

  const [residentes, setResidentes] = useState(RESIDENTES_INI);
  const [notas, setNotas] = useState(NOTAS_INI);
  const [alertas, setAlertas] = useState(ALERTAS_INI);
  const [asistencias, setAsistencias] = useState(ASIST_INI);
  const [actividades, setActividades] = useState(ACTS_INI);
  const [entregas, setEntregas] = useState(ENTREGAS_INI);
  const [pertenencias, setPertenencias] = useState(PERTENENCIAS_INI);
  const [configSedes, setConfigSedes] = useState({ cund:{glu:true,dolor:true}, samp:{glu:false,dolor:true}, favo:{glu:true,dolor:false} });

  const [fichaId, setFichaId] = useState(null);
  const [preselNota, setPreselNota] = useState('');
  const [modal, setModal] = useState(null);
  const [showCookie, setShowCookie] = useState(false);
  const [showLegal, setShowLegal] = useState(false);
  const [toast, setToast] = useState(null);

  useEffect(() => {
    const consent = localStorage.getItem('auracare_cookie_consent');
    if(!consent) setShowCookie(true);
  }, []);

  const avisar = msg => { setToast(msg); setTimeout(() => setToast(null), 3400); };

  const navegarA = (nuevaVista) => {
    if(view !== nuevaVista){
      setNavStack(prev => [...prev, nuevaVista]);
      setView(nuevaVista);
    }
  };

  const goBack = () => {
    if(navStack.length > 1){
      const nuevoStack = [...navStack];
      nuevoStack.pop();
      const previa = nuevoStack[nuevoStack.length - 1];
      setNavStack(nuevoStack);
      setView(previa);
    } else {
      setView('panel');
    }
  };

  const loginUsuario = (email, password) => {
    const enco = usuarios.find(u => u.email.toLowerCase() === email.toLowerCase());
    if(!enco){
      avisar('⛔ Usuario no encontrado. Regístrese o solicite invitación.');
      return;
    }
    if(enco.estado === 'pendiente'){
      avisar('ℹ️ Cuenta Pendiente de Aprobación por un Administrador.');
      return;
    }
    if(enco.clave !== password){
      avisar('⛔ Contraseña incorrecta.');
      return;
    }
    const r = ROLES.find(x => x.id === enco.rolId) || ROLES[0];
    setUsuarioActivo(enco);
    setRolActivo(r);
    setSecretPass(password);
    setSedeId(enco.sedeId || 'cund');
    setJornada('dia');
    setPantalla('app');
    setNavStack(['panel']);
    setView('panel');
    avisar(`Sesión iniciada: ${enco.nombre} (${r.nombre}) ✓`);
  };

  const solicitarCuenta = ({ nombre, email }) => {
    const nuevo = { id:'u' + Date.now(), nombre, email, rolId:'auxiliar', sedeId:'cund', jornadaPermitida:'ambos', estado:'pendiente' };
    setUsuarios(prev => [...prev, nuevo]);
    avisar('Solicitud enviada ✓ Pendiente de aprobación.');
  };

  const logout = () => {
    setUsuarioActivo(null);
    setPantalla('login');
    setNavStack(['panel']);
    avisar('Sesión cerrada con seguridad ✓');
  };

  const actualizarNombre = nombre => {
    setUsuarios(prev => prev.map(u => u.id === usuarioActivo.id ? {...u, nombre} : u));
    setUsuarioActivo(prev => ({...prev, nombre}));
    avisar('Nombre actualizado ✓');
  };

  const cambiarJornada = (nuevaJornada) => {
    setJornada(nuevaJornada);
    avisar(`Jornada activa: ${nuevaJornada.toUpperCase()} ✓`);
  };

  const guardarNota = async ({ personaId, tipo, descripcion, signos }) => {
    const hora = new Date().toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit',hour12:false});
    const autorStr = `${usuarioActivo ? usuarioActivo.nombre : 'Claudia M. Ríos'} (${rolActivo.nombre})`;

    const descCifrada = await E2EE.cifrarTexto(descripcion, secretPass);
    const prevNota = notas[notas.length - 1];
    const prevHash = prevNota ? prevNota.hash : "GENESIS_2026";
    const notaTemp = { id:'n' + (++SEQ), sedeId, personaId, tipo, jornada, fecha:hoyISO, hora, descripcion, autor: autorStr };
    const nuevoHash = await E2EE.generarHashNota(notaTemp, prevHash);

    const nuevasAlertas = [];
    Object.keys(signos).forEach(k => {
      const e = estadoSigno(k, signos[k]);
      if(e === 'c' || e === 'v') nuevasAlertas.push({ id:'a' + (++SEQ), sedeId, personaId, parametro:k, valor:signos[k], sev: e==='c'?'critica':'vigilancia', estado:'activa', hora });
    });

    const nueva = {
      ...notaTemp,
      descripcion,
      descripcionCifrada: descCifrada,
      signos,
      cargo: rolActivo.nombre,
      vigente: true,
      e2ee: true,
      hash: nuevoHash
    };

    setNotas(prev => [...prev, nueva]);
    if(nuevasAlertas.length) setAlertas(prev => [...prev, ...nuevasAlertas]);
    if(personaId) setResidentes(prev => prev.map(r => r.id === personaId ? {...r, signos:{...r.signos, ...signos}} : r));

    avisar(nuevasAlertas.some(a=>a.sev==='critica') ? '⚠ ALERTA CRÍTICA OMS generada y notificada' : '🔒 Nota Cifrada E2EE y Asentada con Hash SHA-256 ✓');
    if(personaId){ setFichaId(personaId); navegarA('ficha'); } else navegarA('panel');
  };

  const atenderAlerta = id => {
    setAlertas(prev => prev.map(a => a.id === id ? {...a, estado:'atendida'} : a));
    avisar('Alerta marcada como atendida ✓');
  };

  if(pantalla === 'login') return (
    <React.Fragment>
      <Login usuarios={usuarios} onLogin={loginUsuario} onSolicitarCuenta={solicitarCuenta} abrirTerminos={() => setShowLegal(true)} />
      {showCookie && <CookieBanner onAceptar={() => { localStorage.setItem('auracare_cookie_consent','all'); setShowCookie(false); }} onRechazar={() => { localStorage.setItem('auracare_cookie_consent','necessary'); setShowCookie(false); }} abrirTerminos={() => setShowLegal(true)} />}
      {showLegal && <ModalLegal cerrar={() => setShowLegal(false)} />}
    </React.Fragment>
  );

  const sede = sedes.find(s => s.id === sedeId) || sedes[0];
  const config = configSedes[sedeId] || { glu:true, dolor:true };
  const resSede = residentes.filter(r => r.sedeId === sedeId);
  const fichaRes = residentes.find(r => r.id === fichaId);

  const puedeVer = mod => rolActivo.modulos.includes(mod);

  return (
    <div className="shell">
      <aside className="sidebar no-print">
        <Logo dark />

        {/* CUADRO DE UNIDAD OPERATIVA ULTRA-MODERNO V3.4 */}
        <div className="sede-box-v34">
          <div className="sede-header-v34">
            <span className="sede-tag-v34">
              <span className="sede-live-dot"></span>
              Sede Operativa
            </span>
            <span className="sede-cupos-v34">{resSede.length}/{sede.cupos} cupos</span>
          </div>
          <div className="sede-select-wrapper">
            <select className="sede-select-v34" id="sel-sede" value={sedeId} onChange={e=>{ setSedeId(e.target.value); navegarA('panel'); }}>
              {sedes.map(s => <option key={s.id} value={s.id}>{s.nombre}</option>)}
            </select>
            <span className="sede-select-arrow">▼</span>
          </div>
        </div>

        <nav className="nav" aria-label="Navegación principal">
          {puedeVer('panel') && <button className={view==='panel'?'active':''} onClick={()=>navegarA('panel')}>◳ Panel General</button>}
          {puedeVer('residentes') && <button className={view==='residentes'||view==='ficha'?'active':''} onClick={()=>navegarA('residentes')}>♥ Residentes</button>}
          {puedeVer('nueva') && <button className={view==='nueva'?'active':''} onClick={()=>{ setPreselNota(''); navegarA('nueva'); }}>＋ Nueva Nota</button>}
          {puedeVer('asistencia') && <button className={view==='asistencia'?'active':''} onClick={()=>navegarA('asistencia')}>☑ Asistencia & Actividades</button>}
          {puedeVer('dotacion') && <button className={view==='dotacion'?'active':''} onClick={()=>navegarA('dotacion')}>⛨ Dotación de Elementos</button>}
          {puedeVer('entrega') && <button className={view==='entrega'?'active':''} onClick={()=>navegarA('entrega')}>🤝 Entrega de Turno</button>}
          {puedeVer('sdis') && <button className={view==='sdis'?'active':''} onClick={()=>navegarA('sdis')}>▤ Registro SDIS</button>}
          {puedeVer('config') && <button className={view==='config'?'active':''} onClick={()=>navegarA('config')}>⚙ Configuración</button>}
          {rolActivo.id === 'superadmin' && puedeVer('admin_usuarios') && <button className={view==='admin_usuarios'?'active':''} onClick={()=>navegarA('admin_usuarios')}>👥 Gestión de Usuarios</button>}
        </nav>
        <div className="sidebar-foot">
          Fundación Construyendo Futuro ONG<br/>NIT 900310195-2 · Ley 1581 / SDIS<br/>
          <b>AuraCare Notaría Médica v3.4</b>
        </div>
      </aside>

      <main className="main">
        {/* TOPBAR CABECERA CON NAVEGACIÓN GLOBAL CONSISTENTE (EL BOTÓN ATRÁS SE OCULTA ÚNICAMENTE EN PANEL) */}
        <div className="topbar no-print">
          <div className="nav-global">
            {view !== 'panel' && (
              <button className="btn-nav-top" onClick={goBack} title="Volver a la pantalla anterior">⬅ Atrás</button>
            )}
          </div>
          <div className="titulo">
            <h2>{view === 'panel' ? 'Panel General' : view === 'residentes' ? 'Personas Mayores' : view === 'ficha' ? 'Ficha Clínica' : view === 'nueva' ? 'Nueva Nota Médica' : view === 'asistencia' ? 'Asistencia & Actividades' : view === 'dotacion' ? 'Dotación de Elementos' : view === 'entrega' ? 'Entrega de Turno' : view === 'sdis' ? 'Registro SDIS FOR-PSS-729' : view === 'config' ? 'Configuración' : view === 'admin_usuarios' ? 'Gestión de Usuarios' : 'Mi Perfil'}</h2>
            <p>{sede.nombre} · {fmtFecha(hoyISO)}</p>
          </div>
          <div className="spacer"></div>

          <div className="jornada-pill" role="group" aria-label="Jornada de atención">
            <button className={jornada==='dia'?'on':''} onClick={()=>cambiarJornada('dia')}>☀ Día</button>
            <button className={jornada==='noche'?'on':''} onClick={()=>cambiarJornada('noche')}>☾ Noche</button>
          </div>

          <div className="nav-global">
            <button className="btn-nav-top" onClick={()=>navegarA('perfil')}>👤 Mi Perfil</button>
            <button className="btn-nav-top" style={{color:'var(--alerta)',borderColor:'#F2C4B6'}} onClick={logout}>🚪 Salir</button>
          </div>
        </div>

        {/* VISTAS OPERATIVAS */}
        {view === 'panel' && <Dashboard sede={sede} residentes={resSede} notas={notas} alertas={alertas} asistencias={asistencias} onAtender={atenderAlerta} jornada={jornada} />}
        
        {view === 'residentes' && <Residentes residentes={resSede} irFicha={id=>{setFichaId(id);navegarA('ficha');}} abrirNuevo={()=>setModal('nuevo')} abrirImport={()=>setModal('import')} />}
        
        {view === 'ficha' && fichaRes && <Ficha res={fichaRes} notas={notas} config={configSedes[fichaRes.sedeId] || {glu:true,dolor:true}} volver={()=>navegarA('residentes')} nuevaNotaPara={id=>{ setPreselNota(id); navegarA('nueva'); }} />}
        
        {view === 'nueva' && <NuevaNota sede={sede} residentes={resSede} jornada={jornada} presel={preselNota} config={config} onGuardar={guardarNota} />}
        
        {view === 'asistencia' && <Asistencia sede={sede} residentes={resSede} asistencias={asistencias} setAsist={setAsistencias} actividades={actividades} setActs={setActividades} jornada={jornada} avisar={avisar} />}
        
        {view === 'dotacion' && <Dotacion sede={sede} residentes={resSede} entregas={entregas} setEntregas={setEntregas} pertenencias={pertenencias} setPert={setPertenencias} avisar={avisar} />}
        
        {view === 'entrega' && <EntregaTurno sede={sede} jornada={jornada} residentes={resSede} notas={notas} alertas={alertas} usuario={usuarioActivo} />}
        
        {view === 'sdis' && <RegistroSdis sede={sede} notas={notas} residentes={resSede} jornada={jornada} />}
        
        {view === 'config' && <Config sedes={sedes} setSedes={setSedes} sede={sede} config={config} setConfig={setConfigSedes} avisar={avisar} residentes={residentes} />}
        
        {view === 'admin_usuarios' && rolActivo.id === 'superadmin' && <AdminUsuarios usuarios={usuarios} setUsuarios={setUsuarios} sedes={sedes} sede={sede} jornadaActual={jornada} avisar={avisar} />}
        
        {view === 'perfil' && <PerfilUsuario usuario={usuarioActivo} rol={rolActivo} sede={sede} jornada={jornada} onLogout={logout} onActualizarNombre={actualizarNombre} />}
      </main>

      {modal === 'nuevo' && <NuevoResidente sede={sede} onCrear={f=>{
        setResidentes(prev=>[...prev,{ id:'r'+Date.now(), sedeId:sede.id, nombres:f.nombres.trim(), apellidos:f.apellidos.trim(), doc:f.numDoc||'CC s/n', edad:f.edad?Number(f.edad):null, dx:f.dx||'Sin registrar', signos:{}, hist:{} }]);
        setModal(null); avisar('Residente registrado ✓');
      }} cerrar={()=>setModal(null)} />}
      
      {modal === 'import' && <Importador sede={sede} onImportar={lista=>{
        setResidentes(prev=>[...prev,...lista.map((v,i)=>({ id:'r'+Date.now()+'_'+i, sedeId:sede.id, nombres:v.nombres, apellidos:v.apellidos, doc:v.doc, edad:v.edad, dx:v.dx, signos:{}, hist:{} }))]);
        setModal(null); avisar(lista.length + ' residente(s) importados ✓');
      }} cerrar={()=>setModal(null)} />}

      {showLegal && <ModalLegal cerrar={() => setShowLegal(false)} />}
      {toast && <div className="toast" role="status">{toast}</div>}
    </div>
  );
};

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>
</body>
</html>
