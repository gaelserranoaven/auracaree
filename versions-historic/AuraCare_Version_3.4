/* ============================ MOTOR CRIPTOGRÁFICO DE EXTREMO A EXTREMO (E2EE) ============================ */
const E2EE = {
  async derivarClave(passphrase, saltHex = 'auracare_salt_2026_v34') {
    const enc = new TextEncoder();
    const keyMaterial = await window.crypto.subtle.importKey(
      "raw", enc.encode(passphrase), "PBKDF2", false, ["deriveKey"]
    );
    return window.crypto.subtle.deriveKey(
      {
        name: "PBKDF2",
        salt: enc.encode(saltHex),
        iterations: 100000,
        hash: "SHA-256"
      },
      keyMaterial,
      { name: "AES-GCM", length: 256 },
      false,
      ["encrypt", "decrypt"]
    );
  },

  async cifrarTexto(texto, secretKey) {
    if(!texto) return texto;
    const enc = new TextEncoder();
    const iv = window.crypto.getRandomValues(new Uint8Array(12));
    const key = await this.derivarClave(secretKey);
    const encrypted = await window.crypto.subtle.encrypt(
      { name: "AES-GCM", iv: iv },
      key,
      enc.encode(texto)
    );
    const ivBase64 = btoa(String.fromCharCode(...iv));
    const dataBase64 = btoa(String.fromCharCode(...new Uint8Array(encrypted)));
    return `E2EE::${ivBase64}::${dataBase64}`;
  },

  async generarHashNota(nota, prevHash = "GENESIS_BLOCK_2026") {
    const enc = new TextEncoder();
    const payload = `${prevHash}|${nota.id}|${nota.fecha}|${nota.hora}|${nota.personaId}|${nota.descripcion}|${nota.autor}`;
    const hashBuffer = await window.crypto.subtle.digest('SHA-256', enc.encode(payload));
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('').substring(0, 16);
  }
};

