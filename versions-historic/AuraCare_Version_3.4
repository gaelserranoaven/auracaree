          </div>
          <table className="op">
            <thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Horario Autorizado</th><th>Estado Dinámico (V3.4)</th></tr></thead>
            <tbody>
              {activos.map(u => {
                const r = ROLES.find(x => x.id === u.rolId) || {};
