/* ============================ GESTIÓN DE USUARIOS Y ROLES (V3.4 MEJORADA CON ESTADO ACTIVO/INACTIVO DINÁMICO) ============================ */
const AdminUsuarios = ({ usuarios, setUsuarios, sedes, sede, jornadaActual, avisar }) => {
  const [fInv, setFInv] = useState({ nombre:'', email:'', rolId:'auxiliar', sedeId:sede.id, jornadaPermitida:'ambos' });

  const invitar = () => {
    if(!fInv.nombre || !fInv.email) return;
    const nuevo = { id:'u' + Date.now(), ...fInv, estado:'activo' };
    setUsuarios(prev => [...prev, nuevo]);
    setFInv({ nombre:'', email:'', rolId:'auxiliar', sedeId:sede.id, jornadaPermitida:'ambos' });
    avisar('Invitación creada y cuenta registrada ✓');
  };

  const cambiarHorarioPermitido = (id, jornadaPermitida) => {
    setUsuarios(prev => prev.map(u => u.id === id ? {...u, jornadaPermitida} : u));
    avisar('Jornada autorizada actualizada ✓');
  };

  const cambiarRol = (id, rolId) => {
    setUsuarios(prev => prev.map(u => u.id === id ? {...u, rolId} : u));
    avisar('Rol actualizado ✓');
  };

  const evaluarEstadoDinamico = (u) => {
    if(u.estado === 'pendiente') return { label:'Pendiente de Aprobación', cls:'inactivo' };
    if(u.jornadaPermitida === 'ambos' || u.jornadaPermitida === jornadaActual) {
      return { label:'● Activo (en turno)', cls:'ok' };
    }
    return { label:'○ Inactivo (fuera de turno)', cls:'inactivo' };
  };

  const pendientes = usuarios.filter(u => u.estado === 'pendiente');
  const activos = usuarios.filter(u => u.estado !== 'pendiente');

  return (
    <div>
      <div className="dos-col" style={{marginBottom:'24px'}}>
        <div className="panel">
          <div className="panel-head"><h3>Crear Invitación de Cuenta</h3></div>
          <div className="panel-body">
            <div className="form-grid" style={{gridTemplateColumns:'1fr',gap:'10px'}}>
              <div className="field" style={{marginBottom:0}}><label>Nombre completo *</label>
                <input value={fInv.nombre} onChange={e=>setFInv(p=>({...p,nombre:e.target.value}))} placeholder="Ej: Dr. Carlos Pérez" /></div>
              <div className="field" style={{marginBottom:0}}><label>Correo institucional *</label>
                <input type="email" value={fInv.email} onChange={e=>setFInv(p=>({...p,email:e.target.value}))} placeholder="carlos.perez@construyendofuturo.org.co" /></div>
              <div className="field" style={{marginBottom:0}}><label>Sede asignada</label>
                <select value={fInv.sedeId} onChange={e=>setFInv(p=>({...p,sedeId:e.target.value}))}>
                  {sedes.map(s => <option key={s.id} value={s.id}>{s.nombre}</option>)}
                </select></div>
              <div className="field" style={{marginBottom:0}}><label>Jornada autorizada</label>
                <select value={fInv.jornadaPermitida} onChange={e=>setFInv(p=>({...p,jornadaPermitida:e.target.value}))}>
                  <option value="ambos">☀/☾ Ambos Horarios (24/7)</option>
                  <option value="dia">☀ Solo Jornada Día (06:00 - 18:00)</option>
                  <option value="noche">☾ Solo Jornada Noche (18:00 - 06:00)</option>
                </select></div>
              <div className="field" style={{marginBottom:0}}><label>Rol del sistema</label>
                <select value={fInv.rolId} onChange={e=>setFInv(p=>({...p,rolId:e.target.value}))}>
                  {ROLES.map(r => <option key={r.id} value={r.id}>{r.nombre}</option>)}
                </select></div>
              <button className="btn btn-primary" onClick={invitar} disabled={!fInv.nombre || !fInv.email}>Registrar e Invitar Usuario</button>
            </div>
          </div>
        </div>

        <div className="panel">
          <div className="panel-head"><h3>Solicitudes Pendientes de Aprobación</h3></div>
          <div className="panel-body">
            {pendientes.length === 0 ? <div className="vacio">No hay solicitudes pendientes.</div> :
              pendientes.map(u => (
                <div key={u.id} style={{padding:'12px 0',borderBottom:'1px dashed var(--linea)'}}>
                  <b>{u.nombre}</b><br/><span style={{fontSize:'12px',color:'var(--texto-2)'}}>{u.email}</span>
                  <button className="mini-btn" style={{marginTop:'8px',background:'var(--vital)',color:'#fff',width:'100%'}}
                    onClick={() => {
                      setUsuarios(prev=>prev.map(x=>x.id===u.id?{...x,estado:'activo'}:x));
                      avisar('Cuenta aprobada ✓');
                    }}>Aprobar y Activar Cuenta ✓</button>
                </div>
              ))}
          </div>
        </div>
      </div>

      <div className="panel">
        <div className="panel-head">
          <h3>Directorio de Usuarios · Estado en Vivo según Horario ({jornadaActual === 'dia' ? '☀ Turno Día' : '☾ Turno Noche'})</h3>
        </div>
        <div className="panel-body">
          <div className="nota-aviso" style={{marginBottom:'14px'}}>
            <span>🕒</span>
