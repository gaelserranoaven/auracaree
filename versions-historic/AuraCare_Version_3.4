const Sparkline = ({ data, estado }) => {
  if(!data || data.length < 2) return null;
  const w = 120, h = 26, min = Math.min(...data), max = Math.max(...data);
  const norm = v => max === min ? h/2 : h - 3 - ((v - min)/(max - min))*(h - 6);
  const pts = data.map((v,i)=> `${(i/(data.length-1))*w},${norm(v).toFixed(1)}`).join(' ');
  const color = estado === 'c' ? 'var(--alerta)' : estado === 'v' ? 'var(--vigilancia)' : 'var(--vital)';
  return <svg className="spark" width={w} height={h} viewBox={`0 0 ${w} ${h}`} aria-hidden="true">
    <polyline points={pts} fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" opacity="0.9"/></svg>;
};

const ChipsSignos = ({ signos }) => {
